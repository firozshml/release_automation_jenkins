pipeline {
    agent { label 'Medium' }

    environment {
        REMOTE_HOST = '10.86.180.76'
        BASE_REMOTE_DIR = "/apps/ingenium/${params.REGION}/server/dbparms/jenkins"
    }

     parameters {
        string(name: 'REGION', defaultValue: 'th', description: 'Region code (e.g.,  t1, th, u1)')
        string(name: 'DB_NAME', defaultValue: 'ingmth', description: 'Database name')
        string(name: 'DB_SCHEMA', defaultValue: 'ingmths', description: 'Database schema')
        string(name: 'RELEASE_DATE', defaultValue: '2026-05-04', description: 'Release date (YYYY-MM-DD format)')
        //choice(name: 'ENVIRONMENT', choices: ['DEV', 'QA', 'PROD'], description: 'Deployment environment')
    }

    stages {

        stage('Node Info') {
            steps {
                echo "Node      : ${env.NODE_NAME}"
                echo "Workspace : ${env.WORKSPACE}"
            }
        }

        stage('Validate Parameters') {
            steps {
                echo "════════════════════════════════════════"
                echo "📋 Pipeline Parameters:"
                echo "  REGION      : ${params.REGION}"
                echo "  DB_NAME     : ${params.DB_NAME}"
                echo "  DB_SCHEMA   : ${params.DB_SCHEMA}"
                echo "  RELEASE_DATE: ${params.RELEASE_DATE}"
		echo "  BASE DIR    : ${BASE_REMOTE_DIR}"
                //echo "  ENVIRONMENT : ${params.ENVIRONMENT}"
                echo "════════════════════════════════════════"
            }
        }

        stage('Checkout GitHub Repo') {
            steps {
                 git(
                    url: 'https://github.com/firozshml/release_automation_jenkins.git',
                    branch: 'main',
                    credentialsId: 'github-jenkins-firozsh'
                    )
            }
        }

        stage('Validate Local Release Files') {
            steps {
                sh '''
                    set -e

                    echo "🔍 Validating local release files"

                    if [ ! -d "sql/ddl/$RELEASE_DATE" ]; then
                        echo "❌ SQL directory not found: sql/ddl/$RELEASE_DATE"
                        exit 1
                    fi

                    if ! ls sql/ddl/$RELEASE_DATE/*.sql >/dev/null 2>&1; then
                        echo "❌ No SQL files found under: sql/ddl/$RELEASE_DATE"
                        exit 1
                    fi

                    if [ ! -f "release_files/table/$RELEASE_DATE/release_plan.txt" ]; then
                        echo "❌ Release plan not found: release_files/table/$RELEASE_DATE/release_plan.txt"
                        exit 1
                    fi

                    echo "✅ Local release files validated"

                    echo "SQL files:"
                    ls -l sql/ddl/$RELEASE_DATE/

                    echo "Release plan:"
                    ls -l release_files/table/$RELEASE_DATE/release_plan.txt
                '''
            }
        }

        stage('Copy SQL & Release Files') {
            agent {
                docker {
                    image 'alpine:3.19'
                    args '-u root:root'
                    reuseNode true
                }
            }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'db-cred-ingmths',
                        usernameVariable: 'SSH_USER',
                        passwordVariable: 'SSH_PASS'
                    )
                ]){
                    sh '''
                      set -e
                      apk add --no-cache openssh sshpass
		      echo "📁 Creating remote directories"
                        sshpass -p "$SSH_PASS" ssh -o StrictHostKeyChecking=no \
                          "$SSH_USER@$REMOTE_HOST" \
                          "mkdir -p \
                            $BASE_REMOTE_DIR/sql/ddl/$RELEASE_DATE \
                            $BASE_REMOTE_DIR/release_files/table/$RELEASE_DATE \
                            $BASE_REMOTE_DIR/logs/$RELEASE_DATE/ddl"

                        echo "📤 Copying SQL files"

                        sshpass -p "$SSH_PASS" scp -o StrictHostKeyChecking=no -r \
                          sql/ddl/$RELEASE_DATE/* \
                          "$SSH_USER@$REMOTE_HOST:$BASE_REMOTE_DIR/sql/ddl/$RELEASE_DATE/"

                        echo "📤 Copying release plan"

                        sshpass -p "$SSH_PASS" scp -o StrictHostKeyChecking=no \
                          release_files/table/$RELEASE_DATE/release_plan.txt \
                          "$SSH_USER@$REMOTE_HOST:$BASE_REMOTE_DIR/release_files/table/$RELEASE_DATE/release_plan.txt"

                        echo "✅ File transfer completed"
                    '''
                }
            }
        }
	
	stage('Verify Remote Files') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'db-cred-ingmths',
                        usernameVariable: 'SSH_USER',
                        passwordVariable: 'SSH_PASS'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "🔍 Verifying files on remote server"

                        sshpass -p "$SSH_PASS" ssh -o StrictHostKeyChecking=no \
                          "$SSH_USER@$REMOTE_HOST" \
                          "echo 'Remote SQL directory:' && \
                           ls -l $BASE_REMOTE_DIR/sql/ddl/$RELEASE_DATE && \
                           echo 'Remote release plan:' && \
                           ls -l $BASE_REMOTE_DIR/release_files/table/$RELEASE_DATE/release_plan.txt && \
                           echo 'Remote script:' && \
                           ls -l $BASE_REMOTE_DIR/scripts/run_table_changes.ksh"

                        echo "✅ Remote file verification completed"
                    '''
                }
            }
        }
        stage('Run Table Changes') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'db-cred-ingmths',
                        usernameVariable: 'SSH_USER',
                        passwordVariable: 'SSH_PASS'
                    )
                ]) {
                    sh '''
                        set -e
                        
                        echo "🚀 Running table changes through remote SSH"
                        
                        sshpass -p "$SSH_PASS" ssh -o StrictHostKeyChecking=no \
                        "$SSH_USER@$REMOTE_HOST" \
                         "cd $BASE_REMOTE_DIR/scripts && \
                         export REGION=${REGION} && \
                         export DB_NAME=${DB_NAME} && \
                         export DB_SCHEMA=${DB_SCHEMA} && \
                         export RELEASE_DATE=${RELEASE_DATE} && \
                         export RELEASE_PLAN_FILE=$BASE_REMOTE_DIR/release_files/table/$RELEASE_DATE/release_plan.txt && \
                        ksh ./run_table_changes.ksh"
                        
                        echo "✅ Table changes completed on remote server"
                    '''
                }
            }
        }
    }

    post {
        always {
            echo '📦 Archiving local Jenkins artifacts if available'
            archiveArtifacts artifacts: '**/logs/**', allowEmptyArchive: true
        }
        success {
            echo '✅ Table changes completed successfully'
        }
        failure {
            echo '❌ Table changes failed'
        }
    }
}
